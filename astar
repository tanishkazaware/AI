
import heapq

# Initial and goal state
start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

# Heuristic: Count misplaced tiles
def h(state):
    return sum(1 for i in range(9)
               if state[i] != 0 and state[i] != goal[i])

# A* Algorithm
def astar(start):
    pq = [(h(start), 0, start, [])]
    visited = set()

    while pq:
        f, g, state, path = heapq.heappop(pq)

        if state in visited:
            continue

        visited.add(state)
        path = path + [state]

        if state == goal:
            return path

        zero = state.index(0)
        moves = [-3, 3, -1, 1]

        for move in moves:
            new = zero + move

            if 0 <= new < 9:
                if move == -1 and zero % 3 == 0:
                    continue
                if move == 1 and zero % 3 == 2:
                    continue

                new_state = list(state)
                new_state[zero], new_state[new] = (
                    new_state[new], new_state[zero])

                new_state = tuple(new_state)

                if new_state not in visited:
                    heapq.heappush(
                        pq,
                        (g + 1 + h(new_state),
                         g + 1, new_state, path)
                    )

    return None

# Display solution
result = astar(start)

if result:
    print("Solution found:")
    for state in result:
        for i in range(0, 9, 3):
            print(state[i:i+3])
        print()
    print("Total moves:", len(result) - 1)
else:
    print("No solution found")


