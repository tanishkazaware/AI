
# Simple Rule-Based Chatbot

print("Chatbot: Hello! Welcome to my chatbot.")
print("Type 'bye' to exit.")

while True:

    user = input("You: ").lower()

    if "hello" in user or "hi" in user:
        print("Bot: Hello! How can I help you?")

    elif "name" in user:
        print("Bot: I am a simple AI chatbot.")

    elif "how are you" in user:
        print("Bot: I am fine. Thank you!")

    elif "course" in user or "subject" in user:
        print("Bot: I can provide basic course information.")

    elif "help" in user:
        print("Bot: Sure! How can I help you?")

    elif "thank" in user:
        print("Bot: You are welcome!")

    elif "bye" in user or "exit" in user or "quit" in user:
        print("Bot: Goodbye! Have a nice day.")
        break

    else:
        print("Bot: Sorry, I do not understand.")


