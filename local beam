
import random

# Distance matrix
dist = [
    [0, 10, 15, 20, 18, 12],
    [10, 0, 35, 25, 17, 28],
    [15, 35, 0, 30, 28, 20],
    [20, 25, 30, 0, 22, 16],
    [18, 17, 28, 22, 0, 14],
    [12, 28, 20, 16, 14, 0]
]

cities = ['A', 'B', 'C', 'D', 'E', 'F']

# Calculate total tour distance
def cost(tour):
    total = 0
    for i in range(len(tour)):
        total += dist[tour[i]][tour[(i+1) % len(tour)]]
    return total

# Local Beam Search
def beam_search(k=4, iterations=10):

    random.seed(10)

    beam = set()

    while len(beam) < k:
        tour = list(range(1, 6))
        random.shuffle(tour)
        beam.add((0,) + tuple(tour))

    beam = sorted(beam, key=cost)[:k]

    best = min(beam, key=cost)

    for step in range(1, iterations + 1):

        neighbors = set()

        for tour in beam:
            for i in range(1, 6):
                for j in range(i+1, 6):

                    new = list(tour)
                    new[i], new[j] = new[j], new[i]

                    neighbors.add(tuple(new))

        beam = sorted(neighbors, key=cost)[:k]

        if cost(beam[0]) < cost(best):
            best = beam[0]

        print("Iteration:", step)
        print("Current Best:", cost(beam[0]))
        print("Global Best:", cost(best))

    print("\nBest Tour:")
    print(" -> ".join(cities[i] for i in best),
          "->", cities[best[0]])

    print("Minimum Distance:", cost(best))


beam_search()



