
from collections import deque

# Initial and goal state
start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

# BFS Algorithm
def bfs(start):

    queue = deque([(start, [])])
    visited = {start}

    while queue:

        state, path = queue.popleft()
        path = path + [state]

        if state == goal:
            return path

        zero = state.index(0)

        for move in [-3, 3, -1, 1]:

            new = zero + move

            if 0 <= new < 9:

                if move == -1 and zero % 3 == 0:
                    continue

                if move == 1 and zero % 3 == 2:
                    continue

                new_state = list(state)
                new_state[zero], new_state[new] = (
                    new_state[new], new_state[zero])

                new_state = tuple(new_state)

                if new_state not in visited:
                    visited.add(new_state)
                    queue.append((new_state, path))

    return None


# Display solution
result = bfs(start)

if result:
    print("Solution Found:")

    for state in result:
        for i in range(0, 9, 3):
            print(state[i:i+3])
        print()

    print("Total Moves:", len(result)-1)

else:
    print("No Solution Found")


