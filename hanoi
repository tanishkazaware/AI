
# Tower of Hanoi using State Space

A = [3, 2, 1]
B = []
C = []

count = 0

def display():
    print("A =", A, "B =", B, "C =", C)

def hanoi(n, source, auxiliary, destination):

    global count

    if n == 1:
        disk = source.pop()
        destination.append(disk)

        count += 1
        print("Move disk", disk)
        display()
        return

    hanoi(n-1, source, destination, auxiliary)

    disk = source.pop()
    destination.append(disk)

    count += 1
    print("Move disk", disk)
    display()

    hanoi(n-1, auxiliary, source, destination)


print("Initial State:")
display()

hanoi(3, A, B, C)

print("Final State:")
display()

print("Total Moves:", count)



