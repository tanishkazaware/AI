
# Simple Reflex Vacuum Cleaner Agent

rooms = {
    'A': 'Dirty',
    'B': 'Dirty'
}

location = 'A'

for i in range(6):

    print("Location:", location)

    if rooms[location] == 'Dirty':
        print("Action: Suck")
        rooms[location] = 'Clean'

    elif location == 'A':
        print("Action: Move Right")
        location = 'B'

    else:
        print("Action: Move Left")
        location = 'A'

    print("Rooms:", rooms)
    print("----------------")

print("Final Environment:", rooms)


