
# DFS for Water Jug Problem

def dfs():

    stack = [((0, 0), [])]
    visited = set()

    while stack:

        state, path = stack.pop()

        if state in visited:
            continue

        visited.add(state)
        path = path + [state]

        x, y = state

        # Check goal
        if x == 2 or y == 2:
            return path

        # Generate possible operations
        next_states = [
            (4, y),  # Fill Jug A
            (x, 3),  # Fill Jug B
            (0, y),  # Empty Jug A
            (x, 0),  # Empty Jug B
            (x-min(x, 3-y), y+min(x, 3-y)),  # A to B
            (x+min(y, 4-x), y-min(y, 4-x))   # B to A
        ]

        for new_state in next_states:
            if new_state not in visited:
                stack.append((new_state, path))

    return None


# Display solution
result = dfs()

if result:
    print("Solution Found:")
    for state in result:
        print(state)

    print("Total Steps:", len(result)-1)
else:
    print("No Solution Found")


